{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KairoDatabase": "",
    "KairoPostgres": ""
  },
  "Providers": {
    "DatabaseProvider": "SqlServer",
    "DefaultLlmProvider": "Mistral",
    "DefaultEmbeddingProvider": "Mistral"
  },
  "Mistral": {
    "ApiKey": "",
    "Model": "mistral-small-latest"
  },
  "MistralEmbedding": {
    "ApiKey": "",
    "Model": "mistral-embed"
  },
  "Reranker": {
    "Enabled": true,
    "Provider": "Mistral",
    "Model": "mistral-small-latest",
    "TimeoutMs": 3000,
    "MaxCandidates": 50
  },
  "Quota": {
    "FailOpen": true
  },
  "Kairo": {
    "Cors": {
      "AllowedOrigins": []
    }
  }
}
