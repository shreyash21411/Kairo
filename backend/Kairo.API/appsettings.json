{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "KairoPostgres": ""
  },
  "Providers": {
    "DatabaseProvider": "PostgreSQL",
    "DefaultLlmProvider": "Mistral",
    "DefaultEmbeddingProvider": "Mistral"
  },
  "Mistral": {
    "ApiKey": "",
    "Model": "mistral-small-latest"
  },
  "MistralEmbedding": {
    "ApiKey": "",
    "Model": "mistral-embed"
  },
  "Reranker": {
    "Enabled": true,
    "Provider": "Mistral",
    "Model": "mistral-small-latest",
    "TimeoutMs": 3000,
    "MaxCandidates": 50
  },
  "Quota": {
    "FailOpen": true
  },
  "ForwardedHeaders": {
    "ForwardLimit": 1,
    "KnownProxies": [],
    "KnownNetworks": [],
    "TrustAllNetworks": false
  },
  "Kairo": {
    "Cors": {
      "AllowedOrigins": []
    }
  }
}
