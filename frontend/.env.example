# VOIDZONE Frontend Environment Configuration
#
# In local development:
# Defaults to http://localhost:5171 when unset.
#
# In production deployments (e.g., Vercel, Docker):
# Must be set to the public VOIDZONE API gateway/backend URL.
# Builds will fail closed at runtime if this is omitted in production.
NEXT_PUBLIC_VOIDZONE_API_URL=http://localhost:5171
